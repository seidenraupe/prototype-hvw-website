# Hostpoint / Apache — Soft-Launch Historischer Verein Winterthur
#
# Stamm-URL bleibt die Weiterleitung zur bestehenden Vereinswebsite.
# Nur /programm ist die neue Soft-Launch-Seite (z. B. Newsletter-Link).

DirectoryIndex index.html

Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # HTTPS erzwingen
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Stamm (/ und /index.html) → bestehende Website
  RewriteRule ^$ https://www.historischer-verein-winterthur.ch/ [L,R=301]
  RewriteRule ^index\.html$ https://www.historischer-verein-winterthur.ch/ [L,R=301]

  # /programm und /programm.html → /programm/
  RewriteRule ^programm$ /programm/ [L,R=301]
  RewriteRule ^programm\.html$ /programm/ [L,R=301]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
